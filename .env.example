# All variables are optional. With none set, everything runs offline in mock mode.

# When set, answers and the faithfulness judge use the Anthropic API instead of the mock.
ANTHROPIC_API_KEY=
# Model for live mode (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# Configuration served by the API, e.g. heading/bm25 for a model-free start
# (default: fixed/hybrid+rerank).
RAG_CONFIG=
# Where MiniLM corpus embeddings are cached (default: .cache/embeddings). An empty value
# disables caching, so this line is commented out.
# RAG_CACHE_DIR=.cache/embeddings
