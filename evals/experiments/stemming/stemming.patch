@@ -13,8 +13,30 @@ STOPWORDS = frozenset(
 )
 
 _TOKEN = re.compile(r"[a-z0-9]+")
+_VOWEL = re.compile(r"[aeiouy]")
+
+
+def stem(word: str) -> str:
+    """A deliberately tiny suffix stripper: "requests" -> "request", "failed" -> "fail".
+
+    Not a real stemmer (no Porter rules). It only has to map the same word to the same
+    stem in questions and documents; "status" -> "statu" is harmless because it is
+    applied consistently on both sides.
+    """
+    for suffix in ("ing", "ed"):
+        root = word.removesuffix(suffix)
+        if root != word and len(root) >= 3 and _VOWEL.search(root):
+            # "cancelled" -> "cancell" -> "cancel"; keep "ll"/"ss" words like "fill" intact
+            if len(root) >= 4 and root[-1] == root[-2] and root[-1] not in "aeiouls":
+                root = root[:-1]
+            elif root.endswith("ll") and len(root) > 5:
+                root = root[:-1]
+            return root
+    if word.endswith("s") and not word.endswith(("ss", "us", "is")) and len(word) > 3:
+        return word[:-1]
+    return word
 
 
 def tokenize(text: str) -> list[str]:
-    """Lowercase alphanumeric tokens with stopwords removed."""
-    return [t for t in _TOKEN.findall(text.lower()) if t not in STOPWORDS]
+    """Lowercase alphanumeric tokens, stopwords removed, light suffix stemming applied."""
+    return [stem(t) for t in _TOKEN.findall(text.lower()) if t not in STOPWORDS]
